# App
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (used by Docker Compose and the app)
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supportdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://supportdesk:change_me@localhost:5432/supportdesk

# Auth (generate a real key: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM (free key from console.groq.com)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile